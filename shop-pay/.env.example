# POSTGRES_PASSWORD phải KHỚP với root .env
DATABASE_URL=postgres://admin:CHANGEME-MATCH-ROOT-POSTGRES_PASSWORD@localhost:5432/shoppay

NEXTAUTH_URL=http://localhost:3200
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32

# KEYCLOAK_CLIENT_SECRET phải KHỚP với SHOPPAY_CLIENT_SECRET trong root .env
KEYCLOAK_CLIENT_ID=shoppay-app
KEYCLOAK_CLIENT_SECRET=changeme-paste-SHOPPAY_CLIENT_SECRET-from-root-env
KEYCLOAK_ISSUER=http://localhost:8080/realms/ecommerce-realm
# Desktop SSO từ Win10 domain-joined: chạy `bash scripts/use-local-domain.sh app.ecommerce.local`
# ở root để đổi NEXTAUTH_URL/KEYCLOAK_ISSUER sang hostname LAN.

# Admin API client (cấp role kyc-verified sau khi approve KYC)
KEYCLOAK_ADMIN_CLIENT_ID=backend-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme-paste-BACKEND_ADMIN_CLIENT_SECRET-from-root-env
