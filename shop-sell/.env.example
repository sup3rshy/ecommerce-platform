# POSTGRES_PASSWORD phải KHỚP với root .env
DATABASE_URL=postgres://admin:CHANGEME-MATCH-ROOT-POSTGRES_PASSWORD@localhost:5432/seller_workspace

NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32

# KEYCLOAK_CLIENT_SECRET phải KHỚP với SELLER_WORKSPACE_CLIENT_SECRET trong root .env
KEYCLOAK_CLIENT_ID=seller-workspace
KEYCLOAK_CLIENT_SECRET=changeme-paste-SELLER_WORKSPACE_CLIENT_SECRET-from-root-env
KEYCLOAK_ISSUER=http://localhost:8080/realms/ecommerce-realm

# === Catalog sync (Phase 1): ShopSell -> ShopEcommerce ===
# CATALOG_SYNC_SECRET phải KHỚP với cùng biến trong shop-ecommerce/.env và root .env.
CATALOG_SYNC_SECRET=changeme-paste-CATALOG_SYNC_SECRET-from-root-env
# URL nội bộ của ShopEcommerce để gọi /api/internal/catalog/*.
# Local: http://localhost:3000. Trong Docker/prod đổi sang service name / domain.
SHOP_ECOMMERCE_INTERNAL_URL=http://localhost:3000
