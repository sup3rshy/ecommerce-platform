{
  "realm": "acme-corp-realm",
  "displayName": "Acme Corp (mock company IdP)",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "verifyEmail": false,
  "passwordPolicy": "length(6)",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "users": [
    {
      "username": "john.doe",
      "email": "john.doe@acme.com",
      "firstName": "John",
      "lastName": "Doe",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Acme@2024", "temporary": false }
      ]
    },
    {
      "username": "jane.smith",
      "email": "jane.smith@acme.com",
      "firstName": "Jane",
      "lastName": "Smith",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Acme@2024", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "http://localhost:8080/realms/ecommerce-realm",
      "name": "Ecommerce Realm SP (broker)",
      "description": "Service Provider — đây là alias của ecommerce-realm khi đóng vai trò SAML SP nhận assertion từ acme-corp-realm.",
      "enabled": true,
      "protocol": "saml",
      "publicClient": true,
      "adminUrl": "http://localhost:8080/realms/ecommerce-realm/broker/acme-corp/endpoint",
      "redirectUris": [
        "http://localhost:8080/realms/ecommerce-realm/broker/acme-corp/endpoint",
        "http://localhost:8080/realms/ecommerce-realm/broker/acme-corp/endpoint/*"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "saml.assertion.signature": "false",
        "saml.server.signature": "false",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.force.post.binding": "true",
        "saml.signing.certificate": "",
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "true",
        "saml_single_logout_service_url_post": "http://localhost:8080/realms/ecommerce-realm/broker/acme-corp/endpoint",
        "saml_single_logout_service_url_redirect": "http://localhost:8080/realms/ecommerce-realm/broker/acme-corp/endpoint"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "friendly.name": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "first name",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "friendly.name": "firstName",
            "attribute.name": "firstName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "last name",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "friendly.name": "lastName",
            "attribute.name": "lastName",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ]
}
