# POSTGRES_PASSWORD phải KHỚP với root .env
DATABASE_URL=postgres://admin:CHANGEME-MATCH-ROOT-POSTGRES_PASSWORD@localhost:5432/shopfood

NEXTAUTH_URL=http://localhost:3300
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32

# KEYCLOAK_CLIENT_SECRET phải KHỚP với SHOPFOOD_CLIENT_SECRET trong root .env
KEYCLOAK_CLIENT_ID=shopfood-app
KEYCLOAK_CLIENT_SECRET=changeme-paste-SHOPFOOD_CLIENT_SECRET-from-root-env
KEYCLOAK_ISSUER=http://localhost:8080/realms/ecommerce-realm
