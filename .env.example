# Copy file này thành `.env` rồi sinh giá trị thật bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# hoặc:  openssl rand -hex 32
#
# KHÔNG BAO GIỜ commit `.env` (đã có trong .gitignore).

# === Postgres ===
POSTGRES_DB=keycloak
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# === Keycloak admin console ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# === Keycloak client secrets ===
# Sau khi sinh giá trị ở đây, copy sang KEYCLOAK_CLIENT_SECRET tương ứng trong
# shop-ecommerce/.env, shop-sell/.env, shop-pay/.env, shop-food/.env, admin-portal/.env.
NEXTJS_APP_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
SELLER_WORKSPACE_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
SHOPPAY_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
SHOPFOOD_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
ADMIN_PORTAL_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
BACKEND_ADMIN_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32

# === SMTP (chưa dùng thật) ===
SMTP_PASSWORD=changeme-app-password-from-gmail-or-equivalent

# === Google Identity Brokering (todo 2.3) ===
# 1. Đăng ký OAuth 2.0 client ở https://console.cloud.google.com/apis/credentials
# 2. Authorized redirect URI: http://localhost:8080/realms/ecommerce-realm/broker/google/endpoint
# 3. Paste client_id + client_secret xuống đây.
# Nếu chưa cần dùng, để "disabled" — Keycloak sẽ tạo IdP entry nhưng không hoạt động.
GOOGLE_IDP_CLIENT_ID=disabled
GOOGLE_IDP_CLIENT_SECRET=disabled

# === Cross-app payment HMAC (ShopEcommerce ↔ ShopPay) ===
# Sinh: openssl rand -hex 32. Phải copy vào cả shop-ecommerce/.env VÀ shop-pay/.env.
MERCHANT_HMAC_SECRET=changeme-generate-with-openssl-rand-hex-32

# === Catalog sync HMAC (ShopSell → ShopEcommerce) ===
# Ký payload đồng bộ sản phẩm từ ShopSell sang ShopEcommerce. Copy vào cả
# shop-sell/.env VÀ shop-ecommerce/.env. Xem PLAN.md Phase 1.
CATALOG_SYNC_SECRET=changeme-generate-with-openssl-rand-hex-32

# === Active Directory / LDAP federation (nhân sự nền tảng) ===
# DC = Windows Server (AD DS) chạy trong VMware TRÊN MÁY LOCAL (chưa cần VPS/Tailscale).
# Keycloak (Docker/WSL2) kết nối tới DC qua IP LAN của VM AD (đặt card mạng VMware = Bridged).
# Hướng dẫn đầy đủ: docs/active-directory.md. Các giá trị này chỉ tham chiếu cho .env;
# cấu hình thật nhập trong Keycloak Admin Console > User Federation.
# LDAP_CONNECTION_URL: IP của DC trong LAN, vd ldap://192.168.1.50:389
LDAP_CONNECTION_URL=ldap://CHANGEME-ip-cua-dc:389
LDAP_BIND_DN=CN=keycloak-svc,OU=ServiceAccounts,DC=ecommerce,DC=local
LDAP_BIND_CREDENTIAL=changeme-service-account-password
LDAP_USERS_DN=OU=Admins,DC=ecommerce,DC=local
# OU chứa các group sẽ map sang role admin / *_admin
LDAP_GROUPS_DN=OU=Groups,DC=ecommerce,DC=local
