# DB riêng cho audit log (Phase 3). Dùng chung Postgres app (port 5432), DB admin_portal.
DATABASE_URL=postgres://admin:changeme-POSTGRES_PASSWORD-from-root-env@localhost:5432/admin_portal
# Tuỳ chọn: Admin Portal đọc số liệu vận hành từ 2 DB này. Nếu bỏ trống, app tự suy
# ra cùng host/user/password với DATABASE_URL và đổi database name.
ECOMMERCE_DATABASE_URL=postgres://admin:changeme-POSTGRES_PASSWORD-from-root-env@localhost:5432/ecommerce
SHOPFOOD_DATABASE_URL=postgres://admin:changeme-POSTGRES_PASSWORD-from-root-env@localhost:5432/shopfood

NEXTAUTH_URL=http://localhost:3400
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32

# KEYCLOAK_CLIENT_SECRET phải KHỚP với ADMIN_PORTAL_CLIENT_SECRET trong root .env
KEYCLOAK_CLIENT_ID=admin-portal
KEYCLOAK_CLIENT_SECRET=changeme-paste-ADMIN_PORTAL_CLIENT_SECRET-from-root-env
KEYCLOAK_ISSUER=http://localhost:8080/realms/ecommerce-realm

# Admin API client (quản lý user/role, duyệt KYC). KHỚP BACKEND_ADMIN_CLIENT_SECRET trong root .env
KEYCLOAK_ADMIN_CLIENT_ID=backend-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme-paste-BACKEND_ADMIN_CLIENT_SECRET-from-root-env
